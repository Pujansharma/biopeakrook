meta {
  name: POST Find Slots
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/centers/{{center_id}}/appointments/slots/
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "customer_profile_id": "{{customer_profile_id}}",
    "service_id": "{{service_id}}",
    "modality": "in_person",
    "date": "2026-09-05",
    "preferred": {
      "room_id": "{{room_id}}"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Returns available slots for a service on a given date. Cap 200/day with truncated flag.
  preferred.care_team_id XOR preferred.doctor_id / health_coach_id. room_id may combine with care_team_id.
  Care team members must still have a live center assignment+role (same as catalog writes). Stale required members → 400 "Care team does not cover all required service roles."
  Eligible associates require an active role; inactive roles are omitted from slots.
  customer_profile_id / service_id must be active at this center. Missing, inactive, or other-center → 400 "Invalid customer profile for this center." / "Invalid service for this center."
}
