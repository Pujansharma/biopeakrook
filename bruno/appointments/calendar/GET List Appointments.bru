meta {
  name: GET List Appointments
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/centers/{{center_id}}/appointments/?start=2026-09-01&granularity=week
  body: none
  auth: bearer
}

params:query {
  start: 2026-09-01
  granularity: week
}

auth:bearer {
  token: {{access_token}}
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Calendar list for center. Week/month capped at 500 with truncated + total_count.
}
​