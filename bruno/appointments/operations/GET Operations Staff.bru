meta {
  name: GET Operations Staff
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/centers/{{center_id}}/appointments/operations/staff/?start=2026-09-01&granularity=week
  body: none
  auth: bearer
}

params:query {
  start: 2026-09-01
  granularity: week
}

auth:bearer {
  token: {{access_token}}
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Staff utilization summary for the center date range.
}
