meta {
  name: POST Book Appointment
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/centers/{{center_id}}/appointments/
  body: json
  auth: bearer
}

headers {
  content-type: application/json
  Idempotency-Key: {{idempotency_key}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "customer_profile_id": "{{customer_profile_id}}",
    "service_id": "{{service_id}}",
    "modality": "in_person",
    "start": "2026-09-09T04:00:00Z",
    "end": "2026-09-09T04:30:00Z",
    "preferred": {
      "room_id": "{{room_id}}"
    },
    "associates": [
      {
        "associate_id": "{{associate_id}}",
        "role_id": "{{role_id}}"
      }
    ],
    "room_id": "{{room_id}}",
    "equipment_id": "{{equipment_id}}",
    "notes": "First visit"
  }
}

script:pre-request {
  if (!bru.getEnvVar('idempotency_key')) {
    bru.setEnvVar('idempotency_key', bru.interpolate('{{$uuid}}'));
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Books a confirmed appointment. Use Idempotency-Key for safe retries.
  Prefer pin from POST Find Slots (associates + room_id + equipment_id) — server validates free, does not re-pick.
  Incomplete pin (associates without room_id for in_person) → 400 "Pin requires room_id for in-person appointments."
  If pin omitted, send preferred; server resolves combo then validates.
  preferred.care_team_id XOR doctor_id/health_coach_id; room_id optional with either.
  Pin + preferred.care_team_id stamps care_team only when every live team member is in the pin.
  Top-level care_team_id removed — use preferred.care_team_id.
  Adjust start/end to match a slot. Overlap → 400 "Slot no longer available."
  customer_profile_id / service_id must be active at this center.
  Invalid room_id / equipment_id → 400 "Invalid room/equipment for this center."
  notes is optional free text, stored on the appointment as-is and also appended to a
  formatted Google event description (patient name, service, date, time, then either
  the clinic address for in_person/both or a "join via Google Meet" line for virtual —
  no address shown for virtual).
  Google Calendar: if the one fixed shared account (GOOGLE_CALENDAR_ID, see
  google_calendar/Connect + Complete) is connected, the appointment is mirrored
  there automatically as this organizer, right after the appointment is saved,
  with assigned associates invited as attendees. Best-effort — booking always
  succeeds even if this sync fails or nobody is connected; a Google failure is
  logged, never surfaced as an error. Response's google_meet_link is populated
  only when the sync succeeded and the appointment is virtual.
}
