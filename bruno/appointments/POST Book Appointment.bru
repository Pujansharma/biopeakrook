meta {
  name: POST Book Appointment
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/centers/{{center_id}}/appointments/
  body: json
  auth: bearer
}

headers {
  content-type: application/json
  Idempotency-Key: {{idempotency_key}}
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "customer_profile_id": "{{customer_profile_id}}",
    "service_id": "{{service_id}}",
    "modality": "in_person",
    "start": "2026-09-05T04:00:00Z",
    "end": "2026-09-05T04:40:00Z",
    "preferred": {
      "room_id": "{{room_id}}"
    },
    "associates": [
      {
        "role_id": "{{role_id}}",
        "associate_id": "{{associate_id}}"
      }
    ],
    "room_id": "{{room_id}}",
    "equipment_id": null
  }
}

script:pre-request {
  if (!bru.getEnvVar('idempotency_key')) {
    bru.setEnvVar('idempotency_key', bru.interpolate('{{$uuid}}'));
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Books a confirmed appointment. Use Idempotency-Key for safe retries.
  Prefer pin from POST Find Slots (associates + room_id + equipment_id) — server validates free, does not re-pick.
  Incomplete pin (associates without room_id for in_person) → 400 "Pin requires room_id for in-person appointments."
  If pin omitted, send preferred; server resolves combo then validates.
  Staff: from service role requirements (auto) and/or preferred care_team_id / doctor_id / health_coach_id.
  Room-only preferred OK when roles exist. Zero roles + no preferred staff → 400
  "At least one associate is required. Send a pin or preferred care_team_id / doctor_id / health_coach_id."
  preferred.care_team_id XOR doctor_id/health_coach_id; room_id optional with either.
  Pin + preferred.care_team_id stamps care_team only when every live team member is in the pin.
  Top-level care_team_id removed — use preferred.care_team_id.
  Booked appointment always has non-empty associates[].
  Adjust start/end to match a slot. Overlap → 400 "Slot no longer available."
  customer_profile_id / service_id must be active at this center.
  Invalid room_id / equipment_id → 400 "Invalid room/equipment for this center."
}
