meta {
  name: POST Cancel
  type: http
  seq: 5
}

post {
  url: {{baseURL}}/centers/{{center_id}}/appointments/{{appointment_id}}/cancel/
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "reason": "Customer requested cancellation"
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Allowed from confirmed or checked_in. Not from in_progress. Reason required.
  Google Calendar: if the appointment was mirrored, the matching event is deleted from the
  fixed shared account's calendar (GOOGLE_CALENDAR_ID) right after this cancel is saved, and
  google_event_id/google_meet_link are cleared in a follow-up save. Best-effort — if that
  Google call fails, the failure is logged and the cancellation stays saved; google_event_id/
  google_meet_link are left as-is (the Google event may still exist and need manual cleanup).
}
