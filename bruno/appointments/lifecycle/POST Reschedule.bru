meta {
  name: POST Reschedule
  type: http
  seq: 7
}

post {
  url: {{baseURL}}/centers/{{center_id}}/appointments/{{appointment_id}}/reschedule/
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "customer_profile_id": "{{customer_profile_id}}",
    "service_id": "{{service_id}}",
    "modality": "in_person",
    "start": "2026-09-05T05:00:00Z",
    "end": "2026-09-05T05:40:00Z",
    "associates": [
      {
        "role_id": "{{role_id}}",
        "associate_id": "{{associate_id}}"
      }
    ],
    "room_id": "{{room_id}}",
    "equipment_id": null
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Allowed from confirmed or checked_in. Lands confirmed. Not from in_progress.
  Send care_team_id XOR associates. Adjust slot to match availability.
  care_team_id: live assignment+role required; stale required members → 400 "Care team does not cover all required service roles."
}
