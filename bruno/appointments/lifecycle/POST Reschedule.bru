meta {
  name: POST Reschedule
  type: http
  seq: 7
}

post {
  url: {{baseURL}}/centers/{{center_id}}/appointments/{{appointment_id}}/reschedule/
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "customer_profile_id": "{{customer_profile_id}}",
    "service_id": "{{service_id}}",
    "modality": "in_person",
    "start": "2026-09-05T05:00:00Z",
    "end": "2026-09-05T05:40:00Z",
    "preferred": {
      "room_id": "{{room_id}}"
    },
    "associates": [
      {
        "role_id": "{{role_id}}",
        "associate_id": "{{associate_id}}"
      }
    ],
    "room_id": "{{room_id}}",
    "equipment_id": null
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Allowed from confirmed or checked_in. Lands confirmed. Not from in_progress.
  Same pin / preferred contract as POST Book Appointment (complete pin or preferred; no silent re-resolve).
  Staff from service roles and/or preferred people/team — same ≥1 associate guard as book.
  Duplicate appointment code IntegrityError → 400 "Appointment code already exists." Overlap → 400 "Slot no longer available."
}
