meta {
  name: Refresh
  type: http
  seq: 5
}

post {
  url: {{baseURL}}/google-calendar/refresh/
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

settings {
  encodeUrl: true
}

docs {
  Forces a refresh of the signed-in associate's own Google Calendar tokens
  right now - fetches a fresh access_token (and a new refresh_token, if
  Google rotates it) from Google, regardless of whether the stored access
  token has actually expired yet, and saves them onto the associate's row.
  Unlike the lazy, only-if-expired refresh get_valid_access_token() does
  internally before every Calendar API call, this always hits Google.
  Always acts on request.user.associate - never a client-supplied id, same
  as Disconnect.

  400 "No Google Calendar connection to refresh." if the associate never
  connected (no google_refresh_token).

  Method: POST
  Path: /google-calendar/refresh/
  Source: integrations.google_calendar.views.GoogleCalendarRefreshTokenView
  Auth: Associate (JWT).

  Success: {"success": true, "detail": "Google Calendar token refreshed."}
}
