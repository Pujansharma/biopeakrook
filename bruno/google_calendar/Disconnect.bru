meta {
  name: Disconnect
  type: http
  seq: 4
}

delete {
  url: {{baseURL}}/google-calendar/disconnect/
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

settings {
  encodeUrl: true
}

docs {
  Revokes the token with Google and clears the signed-in associate's own
  google_access_token / google_refresh_token / google_access_token_expires_at.
  Associate.email (the "connected as ___" address) is deliberately left as
  a record of the last-connected account — check google_refresh_token, not
  email, to know if an associate is actually connected. Always acts on
  request.user.associate - never a client-supplied id.

  Method: DELETE
  Path: /google-calendar/disconnect/
  Source: integrations.google_calendar.views.GoogleCalendarDisconnectView
  Auth: Associate (JWT).
}
