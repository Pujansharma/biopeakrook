meta {
  name: Status
  type: http
  seq: 6
}

get {
  url: {{baseURL}}/google-calendar/
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{access_token}}
}

settings {
  encodeUrl: true
}

docs {
  Returns the signed-in associate's own Google Calendar connection state so
  the frontend can show the right UI after a page reload without ever
  reading token fields off Associate.

  is_connected reflects google_refresh_token, not google_email -
  Associate.google_email is left populated after disconnect as a
  "connected as ___" record.

  Method: GET
  Path: /google-calendar/
  Source: integrations.google_calendar.views.GoogleCalendarStatusView
  Auth: Associate (JWT).
}
