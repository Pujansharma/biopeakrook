meta {
  name: Login Phone Direct
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/auth/login-phone-direct/
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {"phone":"{{phone}}"}
}

script:post-response {
  test('Stores tokens when present', function () {
      const response = res.getBody();
      const data = response.data || {};
      const hasEnvironment = Boolean(pm.environment && bru.getEnvName());
      if (data.access) {
          bru.setCollectionVar('access_token', data.access);
          bru.setCollectionVar('customer_access_token', data.access);
          if (hasEnvironment) {
              bru.setEnvVar('access_token', data.access);
              bru.setEnvVar('customer_access_token', data.access);
          }
      }
      if (data.refresh) {
          bru.setCollectionVar('refresh_token', data.refresh);
          if (hasEnvironment) {
              bru.setEnvVar('refresh_token', data.refresh);
          }
      }
  });
}

settings {
  encodeUrl: true
}

docs {
  Phone-only login without OTP. Looks up existing active User by phone. Create lead via leads/v2 first.
}
