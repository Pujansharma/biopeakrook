meta {
  name: GET List Center Associates
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/centers/{{center_id}}/associates/?page=1&limit=10&active=1&admin=0
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 10
  active: 1
  admin: 0
}

auth:bearer {
  token: {{access_token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Center-scoped associate assignments (admin or associate JWT). Nested role on each item (id, name, role_tag, is_system, is_active). Set env center_id.
  
  Query: page, limit, search (email/phone/name), active=0|1, admin=0|1, care_staff=0|1.
  
  Auth: bearer {{access_token}}. Run Auth → Login Phone Direct first.
}
