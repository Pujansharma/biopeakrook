meta {
  name: GET List Center Services
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/centers/{{center_id}}/services/?page=1&limit=10
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 10
}

auth:bearer {
  token: {{access_token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Services assigned to a center (admin or associate JWT). Set env center_id.

  Query: page, limit.

  Fields: id, name, is_global, centers, service_category, service_category_code, image, centers_count, is_active, is_locked, created_by, timestamps.

  Auth: bearer {{access_token}}. Run Auth -> Login Phone Direct first.
}
