meta {
  name: POST Associate Leave
  type: http
  seq: 7
}

post {
  url: {{baseURL}}/centers/{{center_id}}/availability/associate-leaves/
  body: json
  auth: bearer
}

headers {
  X-Center-ID: {{center_id}}
  content-type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "associate": "{{associate_id}}",
    "scope": "center",
    "center": "{{center_id}}",
    "start_datetime": "2026-09-05T00:00:00+05:30",
    "end_datetime": "2026-09-05T23:59:59+05:30",
    "reason": "Personal leave"
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Associate leave. Body still requires associate. scope=center requires center; scope=all_centers omits center.
  Set associate_leave_id from response for PATCH.
}
