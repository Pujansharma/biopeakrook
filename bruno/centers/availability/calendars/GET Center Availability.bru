meta {
  name: GET Center Availability
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/centers/{{center_id}}/availability/?start=2026-08-25&granularity=week
  body: none
  auth: bearer
}

params:query {
  start: 2026-08-25
  granularity: week
}

headers {
  X-Center-ID: {{center_id}}
}

auth:bearer {
  token: {{access_token}}
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Center weekly operating hours + closures in range. Defaults granularity=week when omitted.
  Omit start → today. Each day includes day_of_week ("0"=Mon … "6"=Sun) and day_of_week_name.
}
​