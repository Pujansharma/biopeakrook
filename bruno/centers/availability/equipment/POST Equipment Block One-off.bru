meta {
  name: POST Equipment Block One-off
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/centers/{{center_id}}/availability/equipment-blocks/{{equipment_id}}/
  body: json
  auth: bearer
}

headers {
  X-Center-ID: {{center_id}}
  content-type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "is_recurring": false,
    "date": "2026-09-04",
    "start_time": "11:00:00",
    "end_time": "13:00:00",
    "reason": "Calibration hold"
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  One-off equipment block. Equipment from URL. Same-day only: date + start_time + end_time. No days_of_week. Response is a one-item list.
  Rejects overlap. Set equipment_block_id from data[0].id for PATCH.
}
