meta {
  name: GET List Center Services V2
  type: http
  seq: 1
}

get {
  url: {{baseURL}}/centers/{{center_id}}/v2/services/?page=1&limit=10&search=
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 10
  search: 
}

headers {
  X-Center-ID: {{center_id}}
}

auth:bearer {
  token: {{access_token}}
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Assigned services + nested assignment config (duration, buffers, modality, required types/roles).
  required_room_type / required_equipment_type / required_roles may be null or empty — not mandatory.
  Query: optional active=0|1 (omit = active + inactive).
  v1 GET /centers/{{center_id}}/services/ unchanged.
}
