meta {
  name: POST Create Equipment Type
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/centers/{{center_id}}/v2/equipment-types/
  body: json
  auth: bearer
}

headers {
  X-Center-ID: {{center_id}}
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "DEXA",
    "portability": "fixed"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Create equipment type. portability: fixed | portable (default fixed).
}
​