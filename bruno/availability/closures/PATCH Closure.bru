meta {
  name: PATCH Closure
  type: http
  seq: 3
}

patch {
  url: {{baseURL}}/centers/{{center_id}}/availability/closures/{{closure_id}}/
  body: json
  auth: bearer
}

headers {
  X-Center-ID: {{center_id}}
  content-type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "is_active": false
  }
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Soft-deactivate (reopen) with is_active=false. Optional PATCH fields: type (holiday|manual), reason (non-blank if sent).
}
