meta {
  name: GET Associate Center Availability
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/centers/{{center_id}}/availability/associates/{{associate_id}}/?start=2026-08-25&granularity=day
  body: none
  auth: bearer
}

params:query {
  start: 2026-08-25
  granularity: day
}

headers {
  X-Center-ID: {{center_id}}
}

auth:bearer {
  token: {{access_token}}
}

settings {
  encodeUrl: true
  timeout: 30000
}

docs {
  Associate calendar at one center (roster intersect center hours minus blocks/leaves/closures).
  Omit start → today. Each day includes day_of_week ("0"=Mon … "6"=Sun) and day_of_week_name.
}
